# Copy to .env and fill in. Never commit .env.

# Public domain of the identity service (Caddy's TLS certificate, Keycloak's hostname), e.g. id.example.com.
SERVICE_DOMAIN=id.example.com

# Postgres: the service's database and Keycloak's (created on the first start, deploy/init-keycloak-db.sh).
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me-too

# Keycloak administrator (master realm). On the first start the bootstrap administrator; later a permanent one.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Internal Keycloak address for the administration commands; compose sets it for the admin service.
KEYCLOAK_URL=http://localhost:8080

# Google sign-in (DI2): OAuth client of type "Web application" in Google Cloud; redirect address
# https://<SERVICE_DOMAIN>/realms/suite/broker/google/endpoint, scopes openid email profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect addresses of product clients after sign-in, comma-separated; empty means no browser sign-in yet.
REDIRECT_DI_RELEASE=
REDIRECT_DI_RELEASE_CONTROL=
REDIRECT_DI_DEFINITION=
REDIRECT_DI_DECISION=
REDIRECT_DI_CHANNELS=
REDIRECT_DI_ADMIN=

# The di-identity service itself (template settings). Locally: http://localhost:8080/realms/suite.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://identity:change-me@localhost:5432/identity
DATABASE_SSL=false
OIDC_ISSUER=https://id.example.com/realms/suite
OIDC_AUDIENCE=di-identity
OIDC_AUTHORIZED_PARTIES=
# Shared secret for signed events between suite services, at least 32 characters.
DI_EVENTS_SECRET=
